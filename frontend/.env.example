# Optional MapLibre style URL. Leave unset to use the bundled local fallback style.
VITE_MAP_STYLE_URL=
# MapTiler API Key for geocoding and map styling
VITE_MAPTILER_API_KEY=PASTE_MAPTILER_API_KEY_HERE

# Backend API prefix. Defaults to /v1 for a same-origin deployment.
# For Vite + FastAPI running separately, use http://127.0.0.1:8000/v1.
VITE_API_URL=/v1
VITE_API_URL=http://127.0.0.1:8000/v1
