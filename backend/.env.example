APP_NAME=SaferPath API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
# Required. This default is for the optional Docker Compose database only.
# For no-Docker development, replace with your hosted/local PostgreSQL + PostGIS URL.
DATABASE_URL=postgresql+psycopg://saferpath:saferpath@localhost:5435/saferpath
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_DEFAULT=100/minute
DEMO_MODE=true
MAX_REQUEST_BODY_BYTES=1048576
ROUTING_PROVIDER=osrm
# Use a managed OSRM deployment in production; this public endpoint is intended for development.
ROUTING_OSRM_URL=https://router.project-osrm.org
ROUTING_OSRM_PROFILE=driving
FIXTURE_PILOT_MIN_LONGITUDE=72.75
FIXTURE_PILOT_MAX_LONGITUDE=72.95
FIXTURE_PILOT_MIN_LATITUDE=18.9
FIXTURE_PILOT_MAX_LATITUDE=19.15
OSM_IMPORT_ENABLED=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_PILOT_BBOX=18.85,72.75,19.35,73.15
OSM_IMPORT_TIMEOUT_SECONDS=60
OSM_IMPORT_MAX_FEATURES=50000
WEATHER_PROVIDER=fixture
OPEN_METEO_BASE_URL=https://api.open-meteo.com
SPATIAL_DISTANCE_STREET_LAMP_METERS=30
SPATIAL_DISTANCE_ACTIVITY_METERS=75
SPATIAL_DISTANCE_TRANSIT_METERS=150
SPATIAL_DISTANCE_DEFAULT_METERS=30
ANALYTICS_RETENTION_DAYS=30
# Set a high-entropy deployment secret; rotating it intentionally creates a new analytics subject scope.
ANALYTICS_SUBJECT_SECRET=replace-in-production
# Leave blank unless internal analytics endpoints are enabled.
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_MINIMUM_COUNT=3
AUTH_SECRET=development-only-auth-secret-change-me
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=24
RATE_LIMIT_BACKEND=local
RATE_LIMIT_REDIS_URL=
MULTI_INSTANCE=false
# Production/release rejects DEBUG, DEMO_MODE, fixture weather, non-HTTPS CORS,
# local trusted hosts, the placeholder subject secret, and short admin tokens.
